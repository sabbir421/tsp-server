PORT=8000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tsp_db

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

OTP_EXPIRES_MINUTES=10

# Using Resend (resend.com) — get an API key from Dashboard > API Keys, use it as SMTP_PASS
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM="TrueSpace Property <onboarding@resend.dev>"

CLIENT_URL=http://localhost:3000
