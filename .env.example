PORT=8000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tsp_db

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

OTP_EXPIRES_MINUTES=10

# AWS S3 Configuration (for property photos, floorplans, verification documents)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_CUSTOM_DOMAIN=

# sms.net.bd — get the key from https://portal.sms.net.bd
SMS_NET_BD_API_KEY=YOUR_API_KEY
SMS_NET_BD_URL=https://api.sms.net.bd/sendsms
# SMS header / masking name (max 11 chars). Must be approved in the sms.net.bd panel.
SMS_NET_BD_SENDER_ID=TSP

CLIENT_URL=http://localhost:3000
